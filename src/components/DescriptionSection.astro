---
import { type HeadingLevel } from "../utilities";
import Heading from "./Heading.astro";

export interface Props {
	title: string;
	headingLevel?: HeadingLevel;
}

const { title, headingLevel = 3 } = Astro.props;
---

<section>
	<div class="header">
		<Heading level={headingLevel} class="heading">{title}</Heading>
	</div>
	<div class="body">
		<slot />
	</div>
</section>

<style>
	section:not(:last-of-type) {
		margin-bottom: 1rem;
	}

	section .header {
		padding-bottom: 0.5rem;
	}

	section :global(blockquote:not(:last-child)),
	section :global(p:not(:last-child)) {
		margin-bottom: 0.5rem;
	}

	section :global(ul) {
		padding-left: 1.5rem;
	}
</style>
