---
export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<section class="description-section">
	<h3>{title}</h3>

	<div class="section-content">
		<slot />
	</div>
</section>

<style>
	section.description-section:not(:last-of-type) {
		margin-bottom: 1rem;
	}

	section.description-section h3 {
		margin-bottom: 0.5rem;
	}

	section.description-section .section-content {
		padding: 0 1rem;
	}

	section.description-section :global(blockquote:not(:last-child)),
	section.description-section :global(p:not(:last-child)) {
		margin-bottom: 0.5rem;
	}

	section.description-section :global(ul) {
		padding-left: 1.5rem;
	}
</style>
