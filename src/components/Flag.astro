---
export interface Props {
	class?: string | undefined | null;
	style?: string | astroHTML.JSX.CSSProperties | undefined | null;
}

const { class: className, style }: Props = Astro.props;
---

<div class={`flag ${className}`} style={style}></div>

<style>
	:root {
		--default-flag-aspect-ratio: calc(2 / 3);
	}

	.flag {
		--proportion: var(--default-flag-aspect-ratio);

		--width: 70vw;
		--height: calc(var(--width) * var(--proportion));

		width: var(--width);
		height: var(--height);

		--shadow-offset: 0.25rem;
		--shadow-blur: calc(2 * var(--shadow-offset));
		box-shadow:
			var(--shadow-offset) var(--shadow-offset) var(--shadow-blur) var(--shadow-color),
			0 0 var(--shadow-blur) var(--shadow-color);

		/**
			Star
				Requires the following variables to be defined:
					- --star-color
					- --star-background-color
					- --star-radius
					- --star-x-position
					- --star-y-position

				Note:
					Sizing and position variables should be defined relative to --width and --height rather than using % units.
		*/
		--star-interior-angle: 36deg;
		--star-indent-angle: 108deg;
		--star-width: calc(var(--star-radius) * 2);
		--star-height: calc(var(--star-radius) * (1 + var(--sin-54)));
		--star-sizing: no-repeat var(--star-x-position) var(--star-y-position) / var(--star-width) var(--star-height);
		--star-sizing-bottom-coverer: no-repeat var(--star-x-position) calc(var(--star-y-position) + 1px) /
			var(--star-width) calc(var(--star-height) + 1px);
		--star-sizing-left-half: no-repeat var(--star-x-position) var(--star-y-position) / calc(var(--star-width) / 2)
			var(--star-height);
		--star-sizing-right-half: no-repeat calc(var(--star-x-position) + var(--star-radius)) var(--star-y-position) /
			calc(var(--star-width) / 2) var(--star-height);
		--star-top-side-h-position: calc(var(--star-radius) * (1 - var(--cos-18)));
		--star-top-side-v-position: calc(var(--star-radius) * (1 - var(--sin-18)));
		--single-five-pointed-star:
			conic-gradient(
					from 90deg at var(--star-top-side-h-position) var(--star-top-side-v-position),
					var(--star-color) 0 var(--star-interior-angle),
					transparent 0 360deg
				)
				var(--star-sizing-left-half),
			conic-gradient(
					from calc(270deg - var(--star-interior-angle)) at calc(100% - var(--star-top-side-h-position))
						var(--star-top-side-v-position),
					var(--star-color) 0 var(--star-interior-angle),
					transparent 0 360deg
				)
				var(--star-sizing-right-half),
			conic-gradient(
					from calc(180deg - 108deg / 2) at 50% calc(100% - var(--star-height) * var(--tan-18) / var(--tan-54) - 1px),
					var(--star-background-color) 0 108deg,
					transparent 0 360deg
				)
				var(--star-sizing-bottom-coverer),
			conic-gradient(
					from calc(180deg - var(--star-interior-angle) / 2) at 50% 0%,
					var(--star-color) 0 var(--star-interior-angle),
					transparent 0 360deg
				)
				var(--star-sizing);
	}

	@media (min-aspect-ratio: 2/1) {
		.flag {
			--height: 70vh;
			--width: calc(var(--height) / var(--proportion));
		}
	}
</style>
