---
import FlagSection from "../FlagSection.astro";
import DescriptionSection from "../DescriptionSection.astro";
import ExternalLink from "../ExternalLink.astro";
import type { HeadingLevel } from "../Heading.astro";

export interface Props {
	headingLevel?: HeadingLevel;
}

const { headingLevel = 2 }: Props = Astro.props;
---

<FlagSection title="Estonia" flagName="Sinimustvalge (Blue-Black-White)" headingLevel={headingLevel}>
	<DescriptionSection title="Description">
		<p>
			The national flag of Estonia (Estonian: Eesti lipp) is a tricolour featuring three equal horizontal bands of blue
			(top), black, and white. The normal size is 105 by 165 centimetres (41 in × 65 in). In Estonian it is colloquially
			called the "sinimustvalge" (lit. "blue-black-white"), after the colours of the bands. (Source: <ExternalLink
				href="https://en.wikipedia.org/wiki/Flag_of_Estonia">Wikipedia</ExternalLink
			>)
		</p>
	</DescriptionSection>

	<DescriptionSection title="Construction">
		<p>
			Created with a <code>linear-gradient</code>.
		</p>
	</DescriptionSection>

	<DescriptionSection title="Sources">
		<ul class="citation-list">
			<li>
				Vexilla Mundi:{" "}
				<ExternalLink href="http://www.vexilla-mundi.com/estonia_flag.html">"Estonia"</ExternalLink>
			</li>
			<li>
				Wikipedia:{" "}
				<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Estonia"> "Flag of Estonia" </ExternalLink>
			</li>
		</ul>
	</DescriptionSection>
</FlagSection>

<style is:global>
	/* prettier-ignore */
	.flag.flag--estonia {
		--blue: #0072ce;
		--black: #000;
		--white: #fff;

		--proportion: calc(7 / 11);

		background-image:
			linear-gradient(
				180deg,
				var(--blue) 0 calc(1 / 3 * var(--height)),
				var(--black) 0 calc(2 / 3 * var(--height)),
				var(--white) 0 calc(3 / 3 * var(--height))
			)
		;
	}
</style>
