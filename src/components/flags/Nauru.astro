---
import FlagSection from "../FlagSection.astro";
import DescriptionSection from "../DescriptionSection.astro";
import ExternalLink from "../ExternalLink.astro";
import { type HeadingLevel, toHeadingLevel } from "../../utilities";

export interface Props {
	headingLevel?: HeadingLevel;
}

const { headingLevel = 2 }: Props = Astro.props;
---

<FlagSection title="Nauru" headingLevel={headingLevel}>
	<DescriptionSection title="Description" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			Following the independence of Nauru, the flag of Nauru (Nauruan: <em>anidenin Naoero</em>) was raised for the
			first time. The flag, chosen in a local design competition, was adopted on independence day, 31 January 1968. It
			depicts Nauru's geographical position, one degree south of the Equator. A gold horizontal stripe representing the
			Equator runs across a blue field for the Pacific Ocean. Nauru itself is symbolized by a white 12-pointed star.
			Each point represents one of the 12 indigenous tribes on the island. (Source:{" "}
			<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Nauru">Wikipedia</ExternalLink>)
		</p>
	</DescriptionSection>

	<DescriptionSection title="Construction" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			The background was created with a <code>linear-gradient</code> and 12 <code>conic-gradient</code>s to form the
			star.
		</p>
	</DescriptionSection>

	<DescriptionSection title="Sources" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<ul class="citation-list">
			<li>
				Scheme Color:{" "}
				<ExternalLink href="https://www.schemecolor.com/nauru-flag-colors.php"> "Nauru Flag Colors" </ExternalLink>
			</li>
			<li>
				Vexilla Mundi:{" "}
				<ExternalLink href="http://www.vexilla-mundi.com/nauru_flag.html">"Nauru"</ExternalLink>
			</li>
			<li>
				Wikipedia:{" "}
				<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Nauru">"Flag of Nauru"</ExternalLink>
			</li>
		</ul>
	</DescriptionSection>
</FlagSection>

<style is:global>
	/* prettier-ignore */
	.flag.flag--nauru {
		--blue: #002b7f;
		--yellow: #ffc61e;
		--white: #fff;

		--proportion: calc(1 / 2);

		--scale: calc(var(--width) / 48);

		--star-outer-radius: calc(4 * var(--scale));
		--star-x: calc(12 * var(--scale));
		--star-y: calc(17 * var(--scale));
		--star-color: var(--white);

		--star-ray-rotation: 30.000000deg;
		--star-ray-angle: 28.103826deg;
		--sin-1-star-ray-rotation: 0.500000;
		--cos-1-star-ray-rotation: 0.866025;
		--sin-2-star-ray-rotation: 0.866025;
		--cos-2-star-ray-rotation: 0.500000;

		background:
			/* Star */
			/* rays (clockwise starting at bottom) */
			conic-gradient(
				from calc(0 * var(--star-ray-rotation) - var(--star-ray-angle) / 2)
				at 50% 100%,
				var(--star-color) 0 var(--star-ray-angle),
				transparent 0 360deg
			) no-repeat calc(var(--star-x) - var(--star-outer-radius)) var(--star-y) / calc(var(--star-outer-radius) * 2) var(--star-outer-radius),
			conic-gradient(
				from calc(1 * var(--star-ray-rotation) - var(--star-ray-angle) / 2)
				at calc(100% - var(--star-outer-radius) * var(--cos-2-star-ray-rotation)) calc(var(--star-outer-radius) * var(--sin-2-star-ray-rotation)),
				var(--star-color) 0 var(--star-ray-angle),
				transparent 0 360deg
			) no-repeat calc(var(--star-x) - var(--star-outer-radius)) var(--star-y) / var(--star-outer-radius) var(--star-outer-radius),
			conic-gradient(
				from calc(2 * var(--star-ray-rotation) - var(--star-ray-angle) / 2)
				at calc(100% - var(--star-outer-radius) * var(--cos-1-star-ray-rotation)) calc(var(--star-outer-radius) * var(--sin-1-star-ray-rotation)),
				var(--star-color) 0 var(--star-ray-angle),
				transparent 0 360deg
			) no-repeat calc(var(--star-x) - var(--star-outer-radius)) var(--star-y) / var(--star-outer-radius) var(--star-outer-radius),
			conic-gradient(
				from calc(3 * var(--star-ray-rotation) - var(--star-ray-angle) / 2)
				at 0 50%,
				var(--star-color) 0 var(--star-ray-angle),
				transparent 0 360deg
			) no-repeat calc(var(--star-x) - var(--star-outer-radius)) calc(var(--star-y) - var(--star-outer-radius)) / var(--star-outer-radius) calc(var(--star-outer-radius) * 2),
			conic-gradient(
				from calc(4 * var(--star-ray-rotation) - var(--star-ray-angle) / 2)
				at calc(100% - var(--star-outer-radius) * var(--cos-1-star-ray-rotation)) calc(100% - var(--star-outer-radius) * var(--sin-1-star-ray-rotation)),
				var(--star-color) 0 var(--star-ray-angle),
				transparent 0 360deg
			) no-repeat calc(var(--star-x) - var(--star-outer-radius)) calc(var(--star-y) - var(--star-outer-radius)) / var(--star-outer-radius) var(--star-outer-radius),
			conic-gradient(
				from calc(5 * var(--star-ray-rotation) - var(--star-ray-angle) / 2)
				at calc(100% - var(--star-outer-radius) * var(--cos-2-star-ray-rotation)) calc(100% - var(--star-outer-radius) * var(--sin-2-star-ray-rotation)),
				var(--star-color) 0 var(--star-ray-angle),
				transparent 0 360deg
			) no-repeat calc(var(--star-x) - var(--star-outer-radius)) calc(var(--star-y) - var(--star-outer-radius)) / var(--star-outer-radius) var(--star-outer-radius),
			conic-gradient(
				from calc(6 * var(--star-ray-rotation) - var(--star-ray-angle) / 2)
				at 50% 0,
				var(--star-color) 0 var(--star-ray-angle),
				transparent 0 360deg
			) no-repeat calc(var(--star-x) - var(--star-outer-radius)) calc(var(--star-y) - var(--star-outer-radius)) / calc(var(--star-outer-radius) * 2) var(--star-outer-radius),
			conic-gradient(
				from calc(7 * var(--star-ray-rotation) - var(--star-ray-angle) / 2)
				at calc(var(--star-outer-radius) * var(--cos-2-star-ray-rotation)) calc(100% - var(--star-outer-radius) * var(--sin-2-star-ray-rotation)),
				var(--star-color) 0 var(--star-ray-angle),
				transparent 0 360deg
			) no-repeat var(--star-x) calc(var(--star-y) - var(--star-outer-radius)) / var(--star-outer-radius) var(--star-outer-radius),
			conic-gradient(
				from calc(8 * var(--star-ray-rotation) - var(--star-ray-angle) / 2)
				at calc(var(--star-outer-radius) * var(--cos-1-star-ray-rotation)) calc(100% - var(--star-outer-radius) * var(--sin-1-star-ray-rotation)),
				var(--star-color) 0 var(--star-ray-angle),
				transparent 0 360deg
			) no-repeat var(--star-x) calc(var(--star-y) - var(--star-outer-radius)) / var(--star-outer-radius) var(--star-outer-radius),
			conic-gradient(
				from calc(9 * var(--star-ray-rotation) - var(--star-ray-angle) / 2)
				at 100% 50%,
				var(--star-color) 0 var(--star-ray-angle),
				transparent 0 360deg
			) no-repeat var(--star-x) calc(var(--star-y) - var(--star-outer-radius)) / var(--star-outer-radius) calc(var(--star-outer-radius) * 2),
			conic-gradient(
				from calc(10 * var(--star-ray-rotation) - var(--star-ray-angle) / 2)
				at calc(var(--star-outer-radius) * var(--cos-1-star-ray-rotation)) calc(var(--star-outer-radius) * var(--sin-1-star-ray-rotation)),
				var(--star-color) 0 var(--star-ray-angle),
				transparent 0 360deg
			) no-repeat var(--star-x) var(--star-y) / var(--star-outer-radius) var(--star-outer-radius),
			conic-gradient(
				from calc(11 * var(--star-ray-rotation) - var(--star-ray-angle) / 2)
				at calc(var(--star-outer-radius) * var(--cos-2-star-ray-rotation)) calc(var(--star-outer-radius) * var(--sin-2-star-ray-rotation)),
				var(--star-color) 0 var(--star-ray-angle),
				transparent 0 360deg
			) no-repeat var(--star-x) var(--star-y) / var(--star-outer-radius) var(--star-outer-radius),

			/* Stripes */
			linear-gradient(
				180deg,
				var(--blue) 0 calc(11 * var(--scale)),
				var(--yellow) 0 calc(13 * var(--scale)),
				var(--blue) 0 calc(24 * var(--scale))
			)
		;
	}
</style>
