---
import FlagSection from "../FlagSection.astro";
import DescriptionSection from "../DescriptionSection.astro";
import ExternalLink from "../ExternalLink.astro";
import { type HeadingLevel, toHeadingLevel } from "../../utilities";

export interface Props {
	headingLevel?: HeadingLevel;
}

const { headingLevel = 2 }: Props = Astro.props;
---

<FlagSection title="Tonga" headingLevel={headingLevel}>
	<DescriptionSection title="Description" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			The flag of Tonga consists of a red field with a white canton charged with a red couped cross. Adopted in 1875
			after being officially enshrined into the nation's constitution, it has been the flag of the Kingdom of Tonga
			since that year. The constitution stipulates that the national flag can never be changed. (Source:{" "}
			<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Tonga">Wikipedia</ExternalLink>)
		</p>
	</DescriptionSection>

	<DescriptionSection title="Construction" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			Created using a red <code>background-color</code> and a <code>linear-gradient</code> for each: the canton and each
			bar of the cross.
		</p>
	</DescriptionSection>

	<DescriptionSection title="Sources" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<ul class="citation-list">
			<li>
				Scheme Color:{" "}
				<ExternalLink href="https://www.schemecolor.com/tonga-flag-colors.php"> "Tonga Flag Colors" </ExternalLink>
			</li>
			<li>
				Vexilla Mundi:{" "}
				<ExternalLink href="http://www.vexilla-mundi.com/tonga_flag.html">"Tonga"</ExternalLink>
			</li>
			<li>
				Wikipedia:{" "}
				<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Tonga">"Flag of Tonga"</ExternalLink>
			</li>
		</ul>
	</DescriptionSection>
</FlagSection>

<style is:global>
	/* prettier-ignore */
	.flag.flag--tonga {
		--red: #c10000;
		--white: #fff;

		--proportion: calc(1 / 2);

		--scale: calc(var(--width) / 168);

		--canton-width: calc(70 * var(--scale));
		--canton-height: calc(42 * var(--scale));
		--cross-thickness: calc(12 * var(--scale));
		--cross-length: calc(34 * var(--scale));

		background:
			linear-gradient(
				0deg,
				var(--red) 0 100%
			) no-repeat calc(18 * var(--scale)) calc(15 * var(--scale)) / var(--cross-length) var(--cross-thickness),
			linear-gradient(
				0deg,
				var(--red) 0 100%
			) no-repeat calc(29 * var(--scale)) calc(4 * var(--scale)) / var(--cross-thickness) var(--cross-length),
			linear-gradient(
				0deg,
				var(--white) 0 100%
			) no-repeat 0 0 / var(--canton-width) var(--canton-height)
		;
		background-color: var(--red);
	}
</style>
