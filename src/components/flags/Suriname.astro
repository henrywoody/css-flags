---
import FlagSection from "../FlagSection.astro";
import DescriptionSection from "../DescriptionSection.astro";
import ExternalLink from "../ExternalLink.astro";
import type { HeadingLevel } from "../Heading.astro";

export interface Props {
	headingLevel?: HeadingLevel;
}

const { headingLevel = 2 }: Props = Astro.props;
---

<FlagSection title="Suriname" headingLevel={headingLevel}>
	<DescriptionSection title="Description">
		<p>
			The flag of Suriname is formed by five horizontal bands of green (top, double width), white, red (quadruple
			width), white, and green (double width). There is a large, yellow, five-pointed star centered in the red band.
			(Source:{" "}
			<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Suriname">Wikipedia</ExternalLink>)
		</p>
	</DescriptionSection>

	<DescriptionSection title="Construction">
		<p>
			The background was formed with a <code>linear-gradient</code>. The star was formed with four{" "}
			<code>conic-gradient</code>s, one for the top and bottom points of the star, one to make the indent at the bottom,
			and one for each of the side points.
		</p>
	</DescriptionSection>

	<DescriptionSection title="Sources">
		<ul class="citation-list">
			<li>
				Vexilla Mundi:{" "}
				<ExternalLink href="http://www.vexilla-mundi.com/suriname_flag.html">"Suriname"</ExternalLink>
			</li>
			<li>
				Wikipedia:{" "}
				<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Suriname"> "Flag of Suriname" </ExternalLink>
			</li>
		</ul>
	</DescriptionSection>
</FlagSection>

<style is:global>
	/* prettier-ignore */
	.flag.flag--suriname {
		--green: #007a33;
		--white: #fff;
		--red: #c8102e;
		--yellow: #ffcd00;

		--proportion: calc(2 / 3);

		--star-color: var(--yellow);
		--star-background-color: var(--red);
		--star-radius: calc(4 / 30 * var(--width));
		--star-x-position: calc((var(--width) - var(--star-width)) / 2);
		--star-y-position: calc((var(--height) - var(--star-height)) / 2);

		background:
			/* Star */
			var(--single-five-pointed-star),

			/* Background */
			linear-gradient(
				0deg,
				var(--green) 0 calc(4 / 20 * var(--height)),
				var(--white) 0 calc(6 / 20 * var(--height)),
				var(--red) 0 calc(14 / 20 * var(--height)),
				var(--white) 0 calc(16 / 20 * var(--height)),
				var(--green) 0 calc(20 / 20 * var(--height))
			)
		;
	}
</style>
