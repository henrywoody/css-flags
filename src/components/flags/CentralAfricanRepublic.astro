---
import FlagSection from "../FlagSection.astro";
import DescriptionSection from "../DescriptionSection.astro";
import ExternalLink from "../ExternalLink.astro";
import type { HeadingLevel } from "../Heading.astro";

export interface Props {
	headingLevel?: HeadingLevel;
}

const { headingLevel = 2 }: Props = Astro.props;
---

<FlagSection title="Central African Republic" headingLevel={headingLevel}>
	<DescriptionSection title="Description">
		<p>
			The national flag of the Central African Republic (Sango: bendêre tî Bêafrîka) was officially adopted in 1958. It
			has been retained since that time with the same design, four horizontal stripes of blue, white, green and yellow,
			and a single vertical band of red, with a yellow five-pointed star in the upper left corner. (Source:{" "}
			<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_the_Central_African_Republic"> Wikipedia </ExternalLink>
			)
		</p>
	</DescriptionSection>

	<DescriptionSection title="Construction">
		<p>
			Created with <code>linear-gradient</code>s for the horizontal and vertical stripes, and four{" "}
			<code>conic-gradient</code>s for the star.
		</p>
	</DescriptionSection>

	<DescriptionSection title="Sources">
		<ul class="citation-list">
			<li>
				Vexilla Mundi:{" "}
				<ExternalLink href="http://www.vexilla-mundi.com/central_african_republic_flag.html">
					"Central African Republic"
				</ExternalLink>
			</li>
			<li>
				Wikipedia:{" "}
				<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_the_Central_African_Republic">
					"Flag of the Central African Republic"
				</ExternalLink>
			</li>
		</ul>
	</DescriptionSection>
</FlagSection>

<style is:global>
	/* prettier-ignore */
	.flag.flag--central-african-republic {
		--blue: #003082;
		--white: #fff;
		--green: #289728;
		--yellow: #ffce00;
		--red: #d21034;

		--proportion: calc(3 / 5);

		--stripe-width: calc(1 / 4 * var(--height));

		--star-color: var(--yellow);
		--star-background-color: var(--blue);
		--star-radius: calc(8 / 120 * var(--width));
		--star-x-position: calc(var(--stripe-width) - var(--star-radius));
		--star-y-position: calc(9 / 72 * var(--height) - var(--star-radius));

		background:
			/* Star */
			var(--single-five-pointed-star),

			/* Stripes */
			linear-gradient(
				90deg,
				transparent 0 calc(var(--width) / 2 - var(--stripe-width) / 2),
				var(--red) 0 calc(var(--width) / 2 + var(--stripe-width) / 2),
				transparent 0 100%
			),
			linear-gradient(
				180deg,
				var(--blue) 0 calc(1 * var(--stripe-width)),
				var(--white) 0 calc(2 * var(--stripe-width)),
				var(--green) 0 calc(3 * var(--stripe-width)),
				var(--yellow) 0 calc(4 * var(--stripe-width))
			)
		;
	}
</style>
