---
import FlagSection from "../FlagSection.astro";
import DescriptionSection from "../DescriptionSection.astro";
import ExternalLink from "../ExternalLink.astro";
import { type HeadingLevel, toHeadingLevel } from "../../utilities";

export interface Props {
	headingLevel?: HeadingLevel;
}

const { headingLevel = 2 }: Props = Astro.props;
---

<FlagSection title="Syria" headingLevel={headingLevel}>
	<DescriptionSection title="Description" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			The current flag was first adopted in 1958 to represent Syria as part of the United Arab Republic, and was used
			until 1961. It was readopted in 1980. Since its first adoption, variations of the red-white-black flag have been
			used in various Arab Unions of Syria with Egypt, Libya, Sudan, Yemen, and Iraq. Although Syria is not part of any
			Arab state union, the flag of the United Arab Republic was readopted to show Syria's commitment to Arab unity. The
			usage of the flag has become disputed because it is often associated with the Ba'ath Party and has come to
			represent parties loyal to Bashar al-Assad's government in the Syrian civil war. (Source:{" "}
			<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Syria">Wikipedia</ExternalLink>)
		</p>
	</DescriptionSection>

	<DescriptionSection title="Construction" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			Created with a <code>linear-gradient</code> for the stripes and six <code>conic-gradients</code> for each of the stars.
		</p>
	</DescriptionSection>

	<DescriptionSection title="Sources" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<ul class="citation-list">
			<li>
				Wikimedia:{" "}
				<ExternalLink href="https://commons.wikimedia.org/wiki/File:Approximate_Construction_of_the_Flag_of_Syria.svg">
					"Approximate Construction of the Flag of Syria"
				</ExternalLink>
			</li>
			<li>
				Wikipedia:{" "}
				<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Syria">"Flag of Syria"</ExternalLink>
			</li>
		</ul>
	</DescriptionSection>
</FlagSection>

<style is:global>
	/* prettier-ignore */
	.flag.flag--syria {
		--red: #ce1126;
		--white: #fff;
		--black: #000;
		--green: #007a3d;

		--proportion: calc(2 / 3);

		--star-color: var(--green);
		--star-background-color: var(--white);
		--star-radius: calc(.75 / 6 * var(--height));
		--star-inner-radius: calc(
			var(--star-radius) * var(--sin-54) - var(--star-radius) * var(--cos-54) * var(--tan-36)
		);

		--star-top-angle: 180deg;
		--star-top-sin: 1.00000;
		--star-top-cos: -0.00000;
		--star-right-angle: calc(var(--star-top-angle) + 144deg);
		--star-right-sin: -0.80902;
		--star-right-cos: 0.58779;
		--star-left-angle: calc(var(--star-top-angle) - 144deg);
		--star-left-sin: -0.80902;
		--star-left-cos: -0.58779;

		/* Left star */
		--left-star-x: calc(3 / 9 * var(--width) - var(--star-radius));
		--left-star-y: 50%;

		/* Right star */
		--right-star-x: calc(6 / 9 * var(--width) - var(--star-radius));
		--right-star-y: 50%;

		background:
			/* Left star */
			/* covers */
			conic-gradient(
				from calc(var(--star-top-angle) - var(--star-indent-angle) / 2)
				at calc(50% + var(--star-inner-radius) * -1 * var(--star-top-cos)) calc(50% - var(--star-inner-radius) * -1 * var(--star-top-sin)),
				var(--star-background-color) 0 var(--star-indent-angle),
				transparent 0 360deg
			) no-repeat calc(var(--left-star-x) - 1px) calc(var(--left-star-y) - 1px) / calc(2 * var(--star-radius) + 2px) calc(2 * var(--star-radius) + 2px),
			conic-gradient(
				from calc(var(--star-right-angle) - var(--star-indent-angle) / 2)
				at calc(50% + var(--star-inner-radius) * -1 * var(--star-right-cos)) calc(50% - var(--star-inner-radius) * -1 * var(--star-right-sin)),
				var(--star-background-color) 0 var(--star-indent-angle),
				transparent 0 360deg
			) no-repeat calc(var(--left-star-x) - 1px) calc(var(--left-star-y) - 1px) / calc(2 * var(--star-radius) + 2px) calc(2 * var(--star-radius) + 2px),
			conic-gradient(
				from calc(var(--star-left-angle) - var(--star-indent-angle) / 2)
				at calc(50% + var(--star-inner-radius) * -1 * var(--star-left-cos)) calc(50% - var(--star-inner-radius) * -1 * var(--star-left-sin)),
				var(--star-background-color) 0 var(--star-indent-angle),
				transparent 0 360deg
			) no-repeat calc(var(--left-star-x) - 1px) calc(var(--left-star-y) - 1px) / calc(2 * var(--star-radius) + 2px) calc(2 * var(--star-radius) + 2px),
			/* star */
			conic-gradient(
				from calc(var(--star-top-angle) - var(--star-interior-angle) / 2)
				at calc(50% + var(--star-radius) * var(--star-top-cos)) calc(50% - var(--star-radius) * var(--star-top-sin)),
				var(--star-color) 0 var(--star-interior-angle),
				transparent 0 360deg
			) no-repeat var(--left-star-x) var(--left-star-y) / calc(2 * var(--star-radius)) calc(2 * var(--star-radius)),
			conic-gradient(
				from calc(var(--star-right-angle) - var(--star-interior-angle) / 2)
				at calc(50% + var(--star-radius) * var(--star-right-cos)) calc(50% - var(--star-radius) * var(--star-right-sin)),
				var(--star-color) 0 var(--star-interior-angle),
				transparent 0 360deg
			) no-repeat var(--left-star-x) var(--left-star-y) / calc(2 * var(--star-radius)) calc(2 * var(--star-radius)),
			conic-gradient(
				from calc(var(--star-left-angle) - var(--star-interior-angle) / 2)
				at calc(50% + var(--star-radius) * var(--star-left-cos)) calc(50% - var(--star-radius) * var(--star-left-sin)),
				var(--star-color) 0 var(--star-interior-angle),
				transparent 0 360deg
			) no-repeat var(--left-star-x) var(--left-star-y) / calc(2 * var(--star-radius)) calc(2 * var(--star-radius)),

			/* Right star */
			/* covers */
			conic-gradient(
				from calc(var(--star-top-angle) - var(--star-indent-angle) / 2)
				at calc(50% + var(--star-inner-radius) * -1 * var(--star-top-cos)) calc(50% - var(--star-inner-radius) * -1 * var(--star-top-sin)),
				var(--star-background-color) 0 var(--star-indent-angle),
				transparent 0 360deg
			) no-repeat calc(var(--right-star-x) - 1px) calc(var(--right-star-y) - 1px) / calc(2 * var(--star-radius) + 2px) calc(2 * var(--star-radius) + 2px),
			conic-gradient(
				from calc(var(--star-right-angle) - var(--star-indent-angle) / 2)
				at calc(50% + var(--star-inner-radius) * -1 * var(--star-right-cos)) calc(50% - var(--star-inner-radius) * -1 * var(--star-right-sin)),
				var(--star-background-color) 0 var(--star-indent-angle),
				transparent 0 360deg
			) no-repeat calc(var(--right-star-x) - 1px) calc(var(--right-star-y) - 1px) / calc(2 * var(--star-radius) + 2px) calc(2 * var(--star-radius) + 2px),
			conic-gradient(
				from calc(var(--star-left-angle) - var(--star-indent-angle) / 2)
				at calc(50% + var(--star-inner-radius) * -1 * var(--star-left-cos)) calc(50% - var(--star-inner-radius) * -1 * var(--star-left-sin)),
				var(--star-background-color) 0 var(--star-indent-angle),
				transparent 0 360deg
			) no-repeat calc(var(--right-star-x) - 1px) calc(var(--right-star-y) - 1px) / calc(2 * var(--star-radius) + 2px) calc(2 * var(--star-radius) + 2px),
			/* star */
			conic-gradient(
				from calc(var(--star-top-angle) - var(--star-interior-angle) / 2)
				at calc(50% + var(--star-radius) * var(--star-top-cos)) calc(50% - var(--star-radius) * var(--star-top-sin)),
				var(--star-color) 0 var(--star-interior-angle),
				transparent 0 360deg
			) no-repeat var(--right-star-x) var(--right-star-y) / calc(2 * var(--star-radius)) calc(2 * var(--star-radius)),
			conic-gradient(
				from calc(var(--star-right-angle) - var(--star-interior-angle) / 2)
				at calc(50% + var(--star-radius) * var(--star-right-cos)) calc(50% - var(--star-radius) * var(--star-right-sin)),
				var(--star-color) 0 var(--star-interior-angle),
				transparent 0 360deg
			) no-repeat var(--right-star-x) var(--right-star-y) / calc(2 * var(--star-radius)) calc(2 * var(--star-radius)),
			conic-gradient(
				from calc(var(--star-left-angle) - var(--star-interior-angle) / 2)
				at calc(50% + var(--star-radius) * var(--star-left-cos)) calc(50% - var(--star-radius) * var(--star-left-sin)),
				var(--star-color) 0 var(--star-interior-angle),
				transparent 0 360deg
			) no-repeat var(--right-star-x) var(--right-star-y) / calc(2 * var(--star-radius)) calc(2 * var(--star-radius)),

			linear-gradient(
				180deg,
				var(--red) 0 calc(1 / 3 * var(--height)),
				var(--white) 0 calc(2 / 3 * var(--height)),
				var(--black) 0 calc(3 / 3 * var(--height))
			)
		;
	}
</style>
