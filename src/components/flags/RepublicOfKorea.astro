---
import FlagSection from "../FlagSection.astro";
import DescriptionSection from "../DescriptionSection.astro";
import ExternalLink from "../ExternalLink.astro";
import { type HeadingLevel, toHeadingLevel } from "../../utilities";

export interface Props {
	headingLevel?: HeadingLevel;
}

const { headingLevel = 2 }: Props = Astro.props;
---

<FlagSection title="Republic of Korea" flagName="태극기 (Taegukgi / Taegeukgi)" headingLevel={headingLevel}>
	<DescriptionSection title="Description" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			The flag of South Korea, also known as the Taegukgi (also spelled as <em>Taegeukgi</em>, lit. "<em
				>Taegeuk flag</em
			>"), has three parts: a white rectangular background, a red and blue Taegeuk in its center, and four black
			trigrams one toward each corner. The first pattern of Taegukgi was made by Kojong. Flags similar to the current
			Taegeukgi were used as the national flags of Korea by the Joseon dynasty, the Korean Empire, and by the Korean
			exile government during Japanese rule. It has continued to be used as a national flag even after the establishment
			of the South Korean state on August 15, 1948. (Source: <ExternalLink
				href="https://en.wikipedia.org/wiki/Flag_of_South_Korea">Wikipedia</ExternalLink
			>)
		</p>
	</DescriptionSection>

	<DescriptionSection title="Construction" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			The Taegeuk in the center was created with a <code>linear-gradient</code> to create the red and blue background halves,
			overlayed with a <code>radial-gradient</code> to crop the shape to a circle. Then overlayed with smaller <code
				>radial-gradient</code
			>s to form the overlaping red and blue sections.
		</p>

		<p>
			The bars around the Taegeuk were created with <code>linear-gradient</code>s on the{" "}
			<code>::before</code> and <code>::after</code> pseudo elements, which were each rotated.
		</p>
	</DescriptionSection>

	<DescriptionSection title="Sources" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<ul class="citation-list">
			<li>
				Wikipedia:{" "}
				<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_South_Korea"> "Flag of South Korea" </ExternalLink>
			</li>
		</ul>
	</DescriptionSection>
</FlagSection>

<style is:global>
	/* prettier-ignore */
	.flag.flag--republic-of-korea {
		--white: #fff;
		--black: #000;
		--red: #cd2e3a;
		--blue: #0047a0;

		--proportion: calc(2 / 3);

		--acute-angle: 33.69deg;
		--cos-acute-angle: 0.83205;
		--sin-acute-angle: 0.55470;
		--taegeuk-radius: calc(0.5 / 3 * var(--width));
		--inner-circle-x-offset: calc(var(--taegeuk-radius) / 2 * var(--cos-acute-angle));
		--inner-circle-y-offset: calc(var(--taegeuk-radius) / 2 * var(--sin-acute-angle));

		--bar-width: calc(1 / 12 / 3 * var(--width));

		background:
			/* Taegeuk */
			radial-gradient(
				circle at calc(50% - var(--inner-circle-x-offset)) calc(50% - var(--inner-circle-y-offset)),
				var(--red) 0 calc(0.5 * var(--taegeuk-radius)),
				transparent 0 100%
			),
			radial-gradient(
				circle at calc(50% + var(--inner-circle-x-offset)) calc(50% + var(--inner-circle-y-offset)),
				var(--blue) 0 calc(0.5 * var(--taegeuk-radius)),
				transparent 0 100%
			),
			radial-gradient(
				circle at center,
				transparent 0 var(--taegeuk-radius),
				var(--white) 0 100%
			),
			linear-gradient(
				var(--acute-angle),
				var(--blue) 0 50%,
				var(--red) 0 100%
			)
		;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.flag.flag--republic-of-korea::before,
	.flag.flag--republic-of-korea::after {
		content: "";
		display: block;
		--width-padding: 16px;
		width: calc((1 + 2 * (1 / 4 + 1 / 3)) / 3 * var(--width) + var(--width-padding));
		height: calc(0.5 / 2 * var(--height));
		position: absolute;

		--base-bars: linear-gradient(
			90deg,
			var(--white) 0 calc(var(--width-padding) / 2),
			var(--black) 0 calc(2 / 2 * var(--bar-width) + var(--width-padding) / 2),
			transparent 0 calc(3 / 2 * var(--bar-width) + var(--width-padding) / 2),
			var(--black) 0 calc(5 / 2 * var(--bar-width) + var(--width-padding) / 2),
			transparent 0 calc(6 / 2 * var(--bar-width) + var(--width-padding) / 2),
			var(--black) 0 calc(8 / 2 * var(--bar-width) + var(--width-padding) / 2),
			transparent 0 calc(100% - 8 / 2 * var(--bar-width) - var(--width-padding) / 2),
			var(--black) 0 calc(100% - 6 / 2 * var(--bar-width) - var(--width-padding) / 2),
			transparent 0 calc(100% - 5 / 2 * var(--bar-width) - var(--width-padding) / 2),
			var(--black) 0 calc(100% - 3 / 2 * var(--bar-width) - var(--width-padding) / 2),
			transparent 0 calc(100% - 2 / 2 * var(--bar-width) - var(--width-padding) / 2),
			var(--black) 0 calc(100% - 0 / 2 * var(--bar-width) - var(--width-padding) / 2),
			var(--white) 0 100%
		);
	}

	.flag.flag--republic-of-korea::before {
		transform: rotate(calc(180deg - var(--acute-angle)));
		background:
			linear-gradient(0deg, var(--white) 0 100%) no-repeat 0 50% / calc(var(--bar-width) + var(--width-padding))
				calc(var(--bar-width) / 2),
			linear-gradient(0deg, var(--white) 0 100%) no-repeat calc(6 / 2 * var(--bar-width)) 50% /
				calc(var(--bar-width) + var(--width-padding)) calc(var(--bar-width) / 2),
			linear-gradient(0deg, var(--white) 0 100%) no-repeat calc(100% - 3 / 2 * var(--bar-width)) 50% /
				calc(var(--bar-width) + var(--width-padding)) calc(var(--bar-width) / 2),
			var(--base-bars);
	}

	.flag.flag--republic-of-korea::after {
		transform: rotate(var(--acute-angle));
		background:
			linear-gradient(0deg, var(--white) 0 100%) no-repeat 100% 50% /
				calc(4 * var(--bar-width) + var(--width-padding) * 2) calc(var(--bar-width) / 2),
			var(--base-bars);
	}
</style>
