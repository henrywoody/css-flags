---
import FlagSection from "../FlagSection.astro";
import DescriptionSection from "../DescriptionSection.astro";
import ExternalLink from "../ExternalLink.astro";
import { type HeadingLevel, toHeadingLevel } from "../../utilities";

export interface Props {
	headingLevel?: HeadingLevel;
}

const { headingLevel = 2 }: Props = Astro.props;
---

<FlagSection title="France" flagName="Tricolore (Tricolor)" headingLevel={headingLevel}>
	<DescriptionSection title="Description" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			The flag of France (French: <em>drapeau français</em>) is a tricolour flag featuring three vertical bands coloured
			blue (hoist side), white, and red. It is known to English speakers as the French Tricolour or simply the Tricolour
			(French: Tricolore). The Tricolour has become one of the most influential flags in history, with its three-colour
			scheme being copied by many other nations, both in Europe and the rest of the world. (Source:{" "}
			<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_France">Wikipedia</ExternalLink>)
		</p>
	</DescriptionSection>

	<DescriptionSection title="Construction" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			Created with a <code>linear-gradient</code>.
		</p>
	</DescriptionSection>

	<DescriptionSection title="Sources" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<ul class="citation-list">
			<li>
				Wikipedia:{" "}
				<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_France">"Flag of France"</ExternalLink>
			</li>
		</ul>
	</DescriptionSection>
</FlagSection>

<style is:global>
	/* prettier-ignore */
	.flag.flag--france {
		--blue: #0055a4;
		--white: #fff;
		--red: #ef4135;

		--proportion: calc(2 / 3);

		background-image:
			linear-gradient(
				90deg,
				var(--blue) 0 calc(1 / 3 * var(--width)),
				var(--white) 0 calc(2 / 3 * var(--width)),
				var(--red) 0 calc(3 / 3 * var(--width))
			)
		;
	}
</style>
