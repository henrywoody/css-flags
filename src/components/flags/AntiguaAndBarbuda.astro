---
import FlagSection from "../FlagSection.astro";
import DescriptionSection from "../DescriptionSection.astro";
import ExternalLink from "../ExternalLink.astro";
import { type HeadingLevel, toHeadingLevel } from "../../utilities";

export interface Props {
	headingLevel?: HeadingLevel;
}

const { headingLevel = 2 }: Props = Astro.props;
---

<FlagSection title="Antigua and Barbuda" headingLevel={headingLevel}>
	<DescriptionSection title="Description" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			The national flag of Antigua and Barbuda was adopted on 27 February 1967 to mark the achievement of
			self-government. A competition to design the flag was held in which more than 600 local people entered. The
			winning design was put forth by nationally well-known artist and sculptor Sir Reginald Samuel.
		</p>

		<p>
			The design is a red field with an inverted isosceles triangle based on the top edge of the field pointed toward
			the bottom edge of the field bearing the horizontal tricolour of black, light blue (half width) and white with the
			rising sun centred on top of the black band. The rising sun symbolises the dawning of a new era. (Source:{" "}
			<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Antigua_and_Barbuda">Wikipedia</ExternalLink>)
		</p>
	</DescriptionSection>

	<DescriptionSection title="Construction" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			The red field was created with a <code>conic-gradient</code>, the tricolor with a{" "}
			<code>linear-gradient</code>, and the sun with 9 <code>conic-gradient</code>s.
		</p>
	</DescriptionSection>

	<DescriptionSection title="Sources" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<ul class="citation-list">
			<li>
				Scheme Color:{" "}
				<ExternalLink href="https://www.schemecolor.com/antigua-flag-colors.php"> "Antigua Flag Colors" </ExternalLink>
			</li>
			<li>
				Vexilla Mundi:{" "}
				<ExternalLink href="http://www.vexilla-mundi.com/antigua_and_barbuda_flag.html">
					"Antigua and Barbuda"
				</ExternalLink>
			</li>
			<li>
				Wikipedia:{" "}
				<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Antigua_and_Barbuda">
					"Flag of Antigua and Barbuda"
				</ExternalLink>
			</li>
		</ul>
	</DescriptionSection>
</FlagSection>

<style is:global>
	/* prettier-ignore */
	.flag.flag--antigua-and-barbuda {
		--red: #ce1126;
		--white: #fff;
		--blue: #0072c6;
		--yellow: #fcd116;
		--black: #000;

		--proportion: calc(2 / 3);

		--scale: calc(var(--width) / 138);

		--red-break-angle: 73.74deg;
		--red-break-start-angle: calc(var(--red-break-angle) / -2);

		--sun-inner-radius: calc(15 * var(--scale));
		--sun-outer-radius: calc(30 * var(--scale));
		--sun-x: calc(var(--width) / 2);
		--sun-y: calc(36 * var(--scale));

		--sun-ray-angle: 21.672102deg;
		--sun-ray-rotation: 22.5deg;
		--cos-sun-ray-rotation: 0.92388;
		--sin-sun-ray-rotation: 0.38268;
		--cos-2-sun-ray-rotation: 0.70711;
		--sin-2-sun-ray-rotation: var(--cos-2-sun-ray-rotation);
		--cos-3-sun-ray-rotation: var(--sin-sun-ray-rotation);
		--sin-3-sun-ray-rotation: var(--cos-sun-ray-rotation);

		background:
			/* Sun */
			conic-gradient(
				from calc(90deg + 0 * var(--sun-ray-rotation) - var(--sun-ray-angle) / 2) at 0 100%,
				var(--yellow) 0 var(--sun-ray-angle),
				transparent 0 360deg
			) no-repeat calc(var(--sun-x) - var(--sun-outer-radius)) calc(var(--sun-y) - var(--sun-outer-radius)) / var(--sun-outer-radius) var(--sun-outer-radius),
			conic-gradient(
				from calc(90deg + 1 * var(--sun-ray-rotation) - var(--sun-ray-angle) / 2)
				at calc(100% - var(--sun-outer-radius) * var(--cos-sun-ray-rotation)) calc(100% - var(--sun-outer-radius) * var(--sin-sun-ray-rotation)),
				var(--yellow) 0 var(--sun-ray-angle),
				transparent 0 360deg
			) no-repeat calc(var(--sun-x) - var(--sun-outer-radius)) calc(var(--sun-y) - var(--sun-outer-radius)) / var(--sun-outer-radius) var(--sun-outer-radius),
			conic-gradient(
				from calc(90deg + 2 * var(--sun-ray-rotation) - var(--sun-ray-angle) / 2)
				at calc(100% - var(--sun-outer-radius) * var(--cos-2-sun-ray-rotation)) calc(100% - var(--sun-outer-radius) * var(--sin-2-sun-ray-rotation)),
				var(--yellow) 0 var(--sun-ray-angle),
				transparent 0 360deg
			) no-repeat calc(var(--sun-x) - var(--sun-outer-radius)) calc(var(--sun-y) - var(--sun-outer-radius)) / var(--sun-outer-radius) var(--sun-outer-radius),
			conic-gradient(
				from calc(90deg + 3 * var(--sun-ray-rotation) - var(--sun-ray-angle) / 2)
				at calc(100% - var(--sun-outer-radius) * var(--cos-3-sun-ray-rotation)) calc(100% - var(--sun-outer-radius) * var(--sin-3-sun-ray-rotation)),
				var(--yellow) 0 var(--sun-ray-angle),
				transparent 0 360deg
			) no-repeat calc(var(--sun-x) - var(--sun-outer-radius)) calc(var(--sun-y) - var(--sun-outer-radius)) / var(--sun-outer-radius) var(--sun-outer-radius),
			conic-gradient(
				from calc(90deg + 4 * var(--sun-ray-rotation) - var(--sun-ray-angle) / 2) at 50% 0,
				var(--yellow) 0 var(--sun-ray-angle),
				transparent 0 360deg
			) no-repeat calc(var(--sun-x) - var(--sun-outer-radius)) calc(var(--sun-y) - var(--sun-outer-radius)) / calc(var(--sun-outer-radius) * 2) var(--sun-outer-radius),
			conic-gradient(
				from calc(90deg + 5 * var(--sun-ray-rotation) - var(--sun-ray-angle) / 2)
				at calc(var(--sun-outer-radius) * var(--cos-3-sun-ray-rotation)) calc(100% - var(--sun-outer-radius) * var(--sin-3-sun-ray-rotation)),
				var(--yellow) 0 var(--sun-ray-angle),
				transparent 0 360deg
			) no-repeat var(--sun-x) calc(var(--sun-y) - var(--sun-outer-radius)) / var(--sun-outer-radius) var(--sun-outer-radius),
			conic-gradient(
				from calc(90deg + 6 * var(--sun-ray-rotation) - var(--sun-ray-angle) / 2)
				at calc(var(--sun-outer-radius) * var(--cos-2-sun-ray-rotation)) calc(100% - var(--sun-outer-radius) * var(--sin-2-sun-ray-rotation)),
				var(--yellow) 0 var(--sun-ray-angle),
				transparent 0 360deg
			) no-repeat var(--sun-x) calc(var(--sun-y) - var(--sun-outer-radius)) / var(--sun-outer-radius) var(--sun-outer-radius),
			conic-gradient(
				from calc(90deg + 7 * var(--sun-ray-rotation) - var(--sun-ray-angle) / 2)
				at calc(var(--sun-outer-radius) * var(--cos-sun-ray-rotation)) calc(100% - var(--sun-outer-radius) * var(--sin-sun-ray-rotation)),
				var(--yellow) 0 var(--sun-ray-angle),
				transparent 0 360deg
			) no-repeat var(--sun-x) calc(var(--sun-y) - var(--sun-outer-radius)) / var(--sun-outer-radius) var(--sun-outer-radius),
			conic-gradient(
				from calc(90deg + 8 * var(--sun-ray-rotation) - var(--sun-ray-angle) / 2) at 100% 100%,
				var(--yellow) 0 var(--sun-ray-angle),
				transparent 0 360deg
			) no-repeat var(--sun-x) calc(var(--sun-y) - var(--sun-outer-radius)) / var(--sun-outer-radius) var(--sun-outer-radius),
			/* Field */
			conic-gradient(
				from var(--red-break-start-angle) at calc(var(--width) / 2) var(--height),
				transparent 0 var(--red-break-angle),
				var(--red) 0 360deg
			),
			/* Tricolor */
			linear-gradient(
				180deg,
				var(--black) 0 calc(36 * var(--scale)),
				var(--blue) 0 calc(56 * var(--scale)),
				var(--white) 0 calc(92 * var(--scale))
			)
		;
	}
</style>
