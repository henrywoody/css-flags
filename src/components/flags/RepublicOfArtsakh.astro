---
import FlagSection from "../FlagSection.astro";
import DescriptionSection from "../DescriptionSection.astro";
import ExternalLink from "../ExternalLink.astro";
import { type HeadingLevel, toHeadingLevel } from "../../utilities";

export interface Props {
	headingLevel?: HeadingLevel;
}

const { headingLevel = 2 }: Props = Astro.props;
---

<FlagSection title="Republic Of Artsakh" headingLevel={headingLevel}>
	<DescriptionSection title="Description" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			On June 2, 1992, the self-proclaimed Republic of Artsakh, a de facto independent republic internationally
			recognized as part of Armenia, in the South Caucasus region, adopted a flag derived from the flag of Armenia, with
			only a white pattern added. A white, five-toothed, stepped pattern was added to the flag, beginning at the two
			verges of the flag's right side and meeting at a point equal to one-third of the distance from that side. The
			white pattern symbolizes the current separation of Artsakh from Armenia proper and its aspiration for eventual
			union with "the Motherland." This symbolizes the Armenian heritage, culture and population of the area, and
			represents Artsakh as a separated region of Armenia by the triangular shape and the zigzag cutting through the
			flag. The white pattern on the flag is also similar to the designs used on rugs, a symbol of national identity.
			The ratio of the flag's breadth to its length is 1:2, same as the Armenian Tricolor. (Source:{" "}
			<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_the_Republic_of_Artsakh"> Wikipedia </ExternalLink>
			)
		</p>
	</DescriptionSection>

	<DescriptionSection title="Construction" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			Created with nine horizontal <code>linear-gradient</code>s, each a single color with a block of white.
		</p>
	</DescriptionSection>

	<DescriptionSection title="Sources" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<ul class="citation-list">
			<li>
				Wikipedia:{" "}
				<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_the_Republic_of_Artsakh">
					"Flag of the Republic of Artsakh"
				</ExternalLink>
			</li>
		</ul>
	</DescriptionSection>
</FlagSection>

<style is:global>
	/* prettier-ignore */
	.flag.flag--republic-of-artsakh {
		--red: #d30017;
		--blue: #0024a1;
		--yellow: #ebab16;
		--white: #fff;

		--proportion: calc(1 / 2);

		background:
			linear-gradient(
				90deg,
				var(--yellow) 0 calc(13 / 15 * 100%),
				var(--white) 0 calc(15 / 15 * 100%),
				var(--yellow) 0 100%
			) 0 calc(8 / 9 * var(--height)),
			linear-gradient(
				90deg,
				var(--yellow) 0 calc(12 / 15 * 100%),
				var(--white) 0 calc(14 / 15 * 100%),
				var(--yellow) 0 100%
			) 0 calc(7 / 9 * var(--height)),
			linear-gradient(
				90deg,
				var(--yellow) 0 calc(11 / 15 * 100%),
				var(--white) 0 calc(13 / 15 * 100%),
				var(--yellow) 0 100%
			) 0 calc(6 / 9 * var(--height)),
			linear-gradient(
				90deg,
				var(--blue) 0 calc(10 / 15 * 100%),
				var(--white) 0 calc(12 / 15 * 100%),
				var(--blue) 0 100%
			) 0 calc(5 / 9 * var(--height)),
			linear-gradient(
				90deg,
				var(--blue) 0 calc(9 / 15 * 100%),
				var(--white) 0 calc(11 / 15 * 100%),
				var(--blue) 0 100%
			) 0 calc(4 / 9 * var(--height)),
			linear-gradient(
				90deg,
				var(--blue) 0 calc(10 / 15 * 100%),
				var(--white) 0 calc(12 / 15 * 100%),
				var(--blue) 0 100%
			) 0 calc(3 / 9 * var(--height)),
			linear-gradient(
				90deg,
				var(--red) 0 calc(11 / 15 * 100%),
				var(--white) 0 calc(13 / 15 * 100%),
				var(--red) 0 100%
			) 0 calc(2 / 9 * var(--height)),
			linear-gradient(
				90deg,
				var(--red) 0 calc(12 / 15 * 100%),
				var(--white) 0 calc(14 / 15 * 100%),
				var(--red) 0 100%
			) 0 calc(1 / 9 * var(--height)),
			linear-gradient(
				90deg,
				var(--red) 0 calc(13 / 15 * 100%),
				var(--white) 0 calc(15 / 15 * 100%),
				var(--red) 0 100%
			) 0 calc(0 / 9 * var(--height))
		;
		background-repeat: no-repeat;
	}
</style>
