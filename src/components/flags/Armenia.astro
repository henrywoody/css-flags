---
import FlagSection from "../FlagSection.astro";
import DescriptionSection from "../DescriptionSection.astro";
import ExternalLink from "../ExternalLink.astro";
import { type HeadingLevel, toHeadingLevel } from "../../utilities";

export interface Props {
	headingLevel?: HeadingLevel;
}

const { headingLevel = 2 }: Props = Astro.props;
---

<FlagSection title="Armenia" flagName="Եռագույն (Tricolor)" headingLevel={headingLevel}>
	<DescriptionSection title="Description" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			The national flag of Armenia, the Armenian Tricolour, consists of three horizontal bands of equal width, red on
			the top, blue in the middle, and apricot on the bottom. The Armenian Supreme Soviet adopted the current flag on 24
			August 1990. On 15 June 2006, the Law on the National Flag of Armenia, governing its usage, was passed by the
			National Assembly of Armenia. (Source:{" "}
			<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Armenia">Wikipedia</ExternalLink>)
		</p>
	</DescriptionSection>

	<DescriptionSection title="Construction" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			Created with a <code>linear-gradient</code>.
		</p>
	</DescriptionSection>

	<DescriptionSection title="Sources" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<ul class="citation-list">
			<li>
				Wikipedia:{" "}
				<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Armenia">"Flag of Armenia"</ExternalLink>
			</li>
		</ul>
	</DescriptionSection>
</FlagSection>

<style is:global>
	/* prettier-ignore */
	.flag.flag--armenia {
		--red: #d90012;
		--blue: #0033a0;
		--orange: #f2a800;

		--proportion: calc(1 / 2);

		background-image:
			linear-gradient(
				180deg,
				var(--red) 0 calc(1 / 3 * var(--height)),
				var(--blue) 0 calc(2 / 3 * var(--height)),
				var(--orange) 0 calc(3 / 3 * var(--height))
			)
		;
	}
</style>
