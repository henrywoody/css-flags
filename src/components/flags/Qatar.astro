---
import FlagSection from "../FlagSection.astro";
import DescriptionSection from "../DescriptionSection.astro";
import ExternalLink from "../ExternalLink.astro";
import { type HeadingLevel, toHeadingLevel } from "../../utilities";

export interface Props {
	headingLevel?: HeadingLevel;
}

const { headingLevel = 2 }: Props = Astro.props;
---

<FlagSection title="Qatar" flagName="Al-Adaam" headingLevel={headingLevel}>
	<DescriptionSection title="Description" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			The national flag of Qatar (Arabic: علم قطر) is in the ratio of 11:28. It is maroon with a broad white serrated
			band (nine white points) on the hoist side. It was adopted shortly before the country's declaration of
			independence from Britain on 3 September 1971. (Source:{" "}
			<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Qatar">Wikipedia</ExternalLink>)
		</p>
	</DescriptionSection>

	<DescriptionSection title="Construction" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			The solid white and maroon colors were created with a <code>linear-gradient</code>. The points along the serrated
			band were created each with two <code>linear-gradient</code>s (one for each side of the point) and repeating
			vertically.
		</p>
	</DescriptionSection>

	<DescriptionSection title="Sources" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<ul class="citation-list">
			<li>
				Vexilla Mundi:{" "}
				<ExternalLink href="http://www.vexilla-mundi.com/qatar_flag.html">"Qatar"</ExternalLink>
			</li>
			<li>
				Wikipedia:{" "}
				<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Qatar">"Flag of Qatar"</ExternalLink>
			</li>
		</ul>
	</DescriptionSection>
</FlagSection>

<style is:global>
	/* prettier-ignore */
	.flag.flag--qatar {
		--white: #fff;
		--maroon: #8a1538;

		--proportion: calc(11 / 28);

		--serration-angle: 16.99deg;
		--serration-h-position: calc(144 / 504 * var(--width));
		--serration-h-size: calc(36 / 504 * var(--width) + 1px);
		--seration-v-size: calc(22 / 198 * var(--height));

		background:
			linear-gradient(
				var(--serration-angle),
				transparent 0 calc(2 / 3 * 100%),
				var(--maroon) 0 100%
			) repeat-y var(--serration-h-position) 0 / var(--serration-h-size) var(--seration-v-size),
			linear-gradient(
				calc(-1 * var(--serration-angle)),
				var(--maroon) 0 calc(1 / 3 * 100%),
				transparent 0 100%
			) repeat-y var(--serration-h-position) 1px / var(--serration-h-size) var(--seration-v-size),
			linear-gradient(
				90deg,
				var(--white) 0 calc(180 / 504 * var(--width)),
				var(--maroon) 0 100%
			)
		;
	}
</style>
