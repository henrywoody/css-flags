---
import FlagSection from "../FlagSection.astro";
import DescriptionSection from "../DescriptionSection.astro";
import ExternalLink from "../ExternalLink.astro";
import { type HeadingLevel, toHeadingLevel } from "../../utilities";

export interface Props {
	headingLevel?: HeadingLevel;
}

const { headingLevel = 2 }: Props = Astro.props;
---

<FlagSection title="Saint Lucia" headingLevel={headingLevel}>
	<DescriptionSection title="Description" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			The flag of Saint Lucia consists of a cerulean blue field charged with a yellow triangle in front of a white-edged
			black isosceles triangle. Adopted in 1967 to replace the British Blue Ensign defaced with the arms of the colony,
			it has been the flag of Saint Lucia since the country became an associated state of the United Kingdom that year.
			Although the overall design of the flag has remained unchanged, specific aspects of it have been altered over the
			years. (Source:{" "}
			<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Saint_Lucia">Wikipedia</ExternalLink>)
		</p>
	</DescriptionSection>

	<DescriptionSection title="Construction" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			Created with a blue <code>background-color</code> and a <code>conic-gradient</code> for each of the three triangles.
		</p>
	</DescriptionSection>

	<DescriptionSection title="Sources" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<ul class="citation-list">
			<li>
				Scheme Color:{" "}
				<ExternalLink href="https://www.schemecolor.com/saint-lucia-flag-colors.php">
					"Saint Lucia Flag Colors"
				</ExternalLink>
			</li>
			<li>
				Vexilla Mundi:{" "}
				<ExternalLink href="http://www.vexilla-mundi.com/saint_lucia_flag.html"> "Saint Lucia" </ExternalLink>
			</li>
			<li>
				Wikipedia:{" "}
				<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Saint_Lucia"> "Flag of Saint Lucia" </ExternalLink>
			</li>
		</ul>
	</DescriptionSection>
</FlagSection>

<style is:global>
	/* prettier-ignore */
	.flag.flag--saint-lucia {
		--blue: #66ccff;
		--yellow: #fcd116;
		--black: #000;
		--white: #fff;

		--proportion: calc(1 / 2);

		--tall-triangle-angle: 48.46deg;
		--short-triangle-angle: 83.98deg;

		background-image:
			linear-gradient(
				0deg,
				var(--blue) 0 10%,
				transparent 0 100%
			),
			conic-gradient(
				from calc(180deg - var(--short-triangle-angle) / 2) at 50% 50%,
				var(--yellow) 0 var(--short-triangle-angle),
				transparent 0 360deg
			),
			conic-gradient(
				from calc(180deg - var(--tall-triangle-angle) / 2) at 50% 20%,
				var(--black) 0 var(--tall-triangle-angle),
				transparent 0 360deg
			),
			conic-gradient(
				from calc(180deg - var(--tall-triangle-angle) / 2) at 50% 10%,
				var(--white) 0 var(--tall-triangle-angle),
				transparent 0 360deg
			)
		;
		background-color: var(--blue);
	}
</style>
