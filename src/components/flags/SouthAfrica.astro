---
import FlagSection from "../FlagSection.astro";
import DescriptionSection from "../DescriptionSection.astro";
import ExternalLink from "../ExternalLink.astro";
import { type HeadingLevel, toHeadingLevel } from "../../utilities";

export interface Props {
	headingLevel?: HeadingLevel;
}

const { headingLevel = 2 }: Props = Astro.props;
---

<FlagSection title="South Africa" headingLevel={headingLevel}>
	<DescriptionSection title="Description" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			The flag of South Africa was designed in March 1994 and adopted on 27 April 1994, at the beginning of South
			Africa's 1994 general election, to replace the flag that had been used since 1928. The new national flag, designed
			by the then State Herald of South Africa Frederick Brownell, was chosen to represent the country's new democracy
			after the end of apartheid. (Source{" "}
			<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_South_Africa">Wikipedia</ExternalLink>)
		</p>
	</DescriptionSection>

	<DescriptionSection title="Construction" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			The horizontal red, white, and blue stripes were created with a <code>linear-gradient</code>, then overlayed with
			the white triangle (using a <code>conic-gradient</code>), followed by the green triangle, then overlayed with a <code
				>linear-gradient</code
			> for the green stripe, and finally two{" "}
			<code>conic-gradient</code>s for the gold and black triangles.
		</p>
	</DescriptionSection>

	<DescriptionSection title="Sources" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<ul class="citation-list">
			<li>
				Vexilla Mundi:{" "}
				<ExternalLink href="http://www.vexilla-mundi.com/south_africa_flag.html"> "South Africa" </ExternalLink>
			</li>
			<li>
				Wikipedia:{" "}
				<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_South_Africa"> "Flag of South Africa" </ExternalLink>
			</li>
		</ul>
	</DescriptionSection>
</FlagSection>

<style is:global>
	/* prettier-ignore */
	.flag.flag--south-africa {
		--red: #E03C31;
		--blue: #001489;
		--green: #007749;
		--white: #fff;
		--gold: #FFB81C;
		--black: #000;

		--proportion: calc(2 / 3);

		--triangle-angle: 67.38deg;
		--white-triangle-h-position: calc(50% + 9.01388 / 45 * var(--width));
		--green-triangle-h-position: calc(50% + 5.40833 / 45 * var(--width));
		--gold-triangle-h-position: calc(50% - 5.40833 / 45 * var(--width));
		--black-triangle-h-position: calc(50% - 9.01388 / 45 * var(--width));

		background-image:
			conic-gradient(
				from calc(-90deg - var(--triangle-angle) / 2) at var(--black-triangle-h-position) 50%,
				var(--black) 0 var(--triangle-angle),
				transparent 0 360deg
			),
			conic-gradient(
				from calc(-90deg - var(--triangle-angle) / 2) at var(--gold-triangle-h-position) 50%,
				var(--gold) 0 var(--triangle-angle),
				transparent 0 360deg
			),
			linear-gradient(
				0deg,
				transparent 0 calc(12 / 30 * var(--height)),
				var(--green) 0 calc(18 / 30 * var(--height)),
				transparent 0 calc(30 / 30 * var(--height))
			),
			conic-gradient(
				from calc(-90deg - var(--triangle-angle) / 2) at var(--green-triangle-h-position) 50%,
				var(--green) 0 var(--triangle-angle),
				transparent 0 360deg
			),
			conic-gradient(
				from calc(-90deg - var(--triangle-angle) / 2) at var(--white-triangle-h-position) 50%,
				var(--white) 0 var(--triangle-angle),
				transparent 0 360deg
			),
			linear-gradient(
				180deg,
				var(--red) 0 calc(10 / 30 * var(--height)),
				var(--white) 0 calc(20 / 30 * var(--height)),
				var(--blue) 0 calc(30 / 30 * var(--height))
			)
		;
	}
</style>
