---
import FlagSection from "../FlagSection.astro";
import DescriptionSection from "../DescriptionSection.astro";
import ExternalLink from "../ExternalLink.astro";
import { type HeadingLevel, toHeadingLevel } from "../../utilities";

export interface Props {
	headingLevel?: HeadingLevel;
}

const { headingLevel = 2 }: Props = Astro.props;
---

<FlagSection
	title="Georgia"
	flagName="ხუთჯვრიანი დროშა (khutjvriani drosha—Five Cross Flag)"
	headingLevel={headingLevel}
>
	<DescriptionSection title="Description" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			The flag of Georgia (Georgian: საქართველოს სახელმწიფო დროშა;{" "}
			<em>Sakartvelos sakhelmts'ipo drosha</em>), also known as the Five Cross Flag (Georgian: ხუთჯვრიანი დროშა,
			romanized: <em>khutjvriani drosha</em>), is one of the national symbols of Georgia. Originally a banner of the
			medieval Kingdom of Georgia, it was repopularized in the late 20th and early 21st centuries during the Georgian
			national revival. (Source:{" "}
			<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Georgia_(country)">Wikipedia</ExternalLink>)
		</p>
	</DescriptionSection>

	<DescriptionSection title="Construction" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			The center cross was formed with two <code>linear-gradient</code>s. Each of the smaller crosses was formed with 8 <code
				>radial-gradient</code
			>s: one for each half of each bar and one for each of the ends of the cross.
		</p>
	</DescriptionSection>

	<DescriptionSection title="Sources" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<ul class="citation-list">
			<li>
				Vexilla Mundi:{" "}
				<ExternalLink href="http://www.vexilla-mundi.com/georgia_flag.html">"Georgia"</ExternalLink>
			</li>
			<li>
				Wikipedia:{" "}
				<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Georgia_(country)">
					"Flag of Georgia (country)"
				</ExternalLink>
			</li>
		</ul>
	</DescriptionSection>
</FlagSection>

<style is:global>
	/* prettier-ignore */
	.flag.flag--georgia {
		--red: #f00;
		--white: #fff;

		--proportion: calc(2 / 3);

		--scale: calc(var(--width) / 300);

		--cross-size: calc(var(--scale) * 40);
		--cross-v-offset: calc(var(--scale) * 20);
		--cross-h-offset: calc(var(--scale) * 45);
		--cross-bottom-v-offset: calc(var(--cross-v-offset) + var(--scale) * 120);
		--cross-right-h-offset: calc(var(--cross-h-offset) + var(--scale) * 170);
		--cross-big-circle-offset: calc(var(--scale) * 89);
		--cross-big-circle-radius: calc(var(--scale) * 104);
		--cross-small-circle-offset: calc(var(--scale) * 54);
		--cross-small-circle-radius: calc(var(--scale) * 56);

		background:
			/* Top Left Cross */
			/* small circles */
			radial-gradient(
				circle at calc(var(--cross-size) / 2) calc(-1 * var(--cross-small-circle-offset)),
				var(--white) 0 var(--cross-small-circle-radius),
				transparent 0 100%
			) no-repeat var(--cross-h-offset) var(--cross-v-offset) / var(--cross-size) var(--cross-size),
			radial-gradient(
				circle at calc(var(--cross-size) / 2) calc(var(--cross-size) + var(--cross-small-circle-offset)),
				var(--white) 0 var(--cross-small-circle-radius),
				transparent 0 100%
			) no-repeat var(--cross-h-offset) var(--cross-v-offset) / var(--cross-size) var(--cross-size),
			radial-gradient(
				circle at calc(-1 * var(--cross-small-circle-offset)) calc(var(--cross-size) / 2),
				var(--white) 0 var(--cross-small-circle-radius),
				transparent 0 100%
			) no-repeat var(--cross-h-offset) var(--cross-v-offset) / var(--cross-size) var(--cross-size),
			radial-gradient(
				circle at calc(var(--cross-size) + var(--cross-small-circle-offset)) calc(var(--cross-size) / 2),
				var(--white) 0 var(--cross-small-circle-radius),
				transparent 0 100%
			) no-repeat var(--cross-h-offset) var(--cross-v-offset) / var(--cross-size) var(--cross-size),
			/* big circles */
			radial-gradient(
				circle at calc(-1 * var(--cross-big-circle-offset)) calc(var(--cross-size) / 2),
				transparent 0 var(--cross-big-circle-radius),
				var(--red) 0 100%
			) no-repeat var(--cross-h-offset) var(--cross-v-offset) / calc(var(--cross-size) / 2) var(--cross-size),
			radial-gradient(
				circle at calc(var(--cross-size) / 2 + var(--cross-big-circle-offset)) calc(var(--cross-size) / 2),
				transparent 0 var(--cross-big-circle-radius),
				var(--red) 0 100%
			) no-repeat calc(var(--cross-h-offset) + var(--cross-size) / 2) var(--cross-v-offset) / calc(var(--cross-size) / 2) var(--cross-size),
			radial-gradient(
				circle at calc(var(--cross-size) / 2) calc(-1 * var(--cross-big-circle-offset)),
				transparent 0 var(--cross-big-circle-radius),
				var(--red) 0 100%
			) no-repeat var(--cross-h-offset) var(--cross-v-offset) / var(--cross-size) calc(var(--cross-size) / 2),
			radial-gradient(
				circle at calc(var(--cross-size) / 2) calc(var(--cross-size) / 2 + var(--cross-big-circle-offset)),
				transparent 0 var(--cross-big-circle-radius),
				var(--red) 0 100%
			) no-repeat var(--cross-h-offset) calc(var(--cross-v-offset) + var(--cross-size) / 2) / var(--cross-size) calc(var(--cross-size) / 2),

			/* Top Right Cross */
			/* small circles */
			radial-gradient(
				circle at calc(var(--cross-size) / 2) calc(-1 * var(--cross-small-circle-offset)),
				var(--white) 0 var(--cross-small-circle-radius),
				transparent 0 100%
			) no-repeat var(--cross-right-h-offset) var(--cross-v-offset) / var(--cross-size) var(--cross-size),
			radial-gradient(
				circle at calc(var(--cross-size) / 2) calc(var(--cross-size) + var(--cross-small-circle-offset)),
				var(--white) 0 var(--cross-small-circle-radius),
				transparent 0 100%
			) no-repeat var(--cross-right-h-offset) var(--cross-v-offset) / var(--cross-size) var(--cross-size),
			radial-gradient(
				circle at calc(-1 * var(--cross-small-circle-offset)) calc(var(--cross-size) / 2),
				var(--white) 0 var(--cross-small-circle-radius),
				transparent 0 100%
			) no-repeat var(--cross-right-h-offset) var(--cross-v-offset) / var(--cross-size) var(--cross-size),
			radial-gradient(
				circle at calc(var(--cross-size) + var(--cross-small-circle-offset)) calc(var(--cross-size) / 2),
				var(--white) 0 var(--cross-small-circle-radius),
				transparent 0 100%
			) no-repeat var(--cross-right-h-offset) var(--cross-v-offset) / var(--cross-size) var(--cross-size),
			/* big circles */
			radial-gradient(
				circle at calc(-1 * var(--cross-big-circle-offset)) calc(var(--cross-size) / 2),
				transparent 0 var(--cross-big-circle-radius),
				var(--red) 0 100%
			) no-repeat var(--cross-right-h-offset) var(--cross-v-offset) / calc(var(--cross-size) / 2) var(--cross-size),
			radial-gradient(
				circle at calc(var(--cross-size) / 2 + var(--cross-big-circle-offset)) calc(var(--cross-size) / 2),
				transparent 0 var(--cross-big-circle-radius),
				var(--red) 0 100%
			) no-repeat calc(var(--cross-right-h-offset) + var(--cross-size) / 2) var(--cross-v-offset) / calc(var(--cross-size) / 2) var(--cross-size),
			radial-gradient(
				circle at calc(var(--cross-size) / 2) calc(-1 * var(--cross-big-circle-offset)),
				transparent 0 var(--cross-big-circle-radius),
				var(--red) 0 100%
			) no-repeat var(--cross-right-h-offset) var(--cross-v-offset) / var(--cross-size) calc(var(--cross-size) / 2),
			radial-gradient(
				circle at calc(var(--cross-size) / 2) calc(var(--cross-size) / 2 + var(--cross-big-circle-offset)),
				transparent 0 var(--cross-big-circle-radius),
				var(--red) 0 100%
			) no-repeat var(--cross-right-h-offset) calc(var(--cross-v-offset) + var(--cross-size) / 2) / var(--cross-size) calc(var(--cross-size) / 2),

			/* Bottom Right Cross */
			/* small circles */
			radial-gradient(
				circle at calc(var(--cross-size) / 2) calc(-1 * var(--cross-small-circle-offset)),
				var(--white) 0 var(--cross-small-circle-radius),
				transparent 0 100%
			) no-repeat var(--cross-right-h-offset) var(--cross-bottom-v-offset) / var(--cross-size) var(--cross-size),
			radial-gradient(
				circle at calc(var(--cross-size) / 2) calc(var(--cross-size) + var(--cross-small-circle-offset)),
				var(--white) 0 var(--cross-small-circle-radius),
				transparent 0 100%
			) no-repeat var(--cross-right-h-offset) var(--cross-bottom-v-offset) / var(--cross-size) var(--cross-size),
			radial-gradient(
				circle at calc(-1 * var(--cross-small-circle-offset)) calc(var(--cross-size) / 2),
				var(--white) 0 var(--cross-small-circle-radius),
				transparent 0 100%
			) no-repeat var(--cross-right-h-offset) var(--cross-bottom-v-offset) / var(--cross-size) var(--cross-size),
			radial-gradient(
				circle at calc(var(--cross-size) + var(--cross-small-circle-offset)) calc(var(--cross-size) / 2),
				var(--white) 0 var(--cross-small-circle-radius),
				transparent 0 100%
			) no-repeat var(--cross-right-h-offset) var(--cross-bottom-v-offset) / var(--cross-size) var(--cross-size),
			/* big circles */
			radial-gradient(
				circle at calc(-1 * var(--cross-big-circle-offset)) calc(var(--cross-size) / 2),
				transparent 0 var(--cross-big-circle-radius),
				var(--red) 0 100%
			) no-repeat var(--cross-right-h-offset) var(--cross-bottom-v-offset) / calc(var(--cross-size) / 2) var(--cross-size),
			radial-gradient(
				circle at calc(var(--cross-size) / 2 + var(--cross-big-circle-offset)) calc(var(--cross-size) / 2),
				transparent 0 var(--cross-big-circle-radius),
				var(--red) 0 100%
			) no-repeat calc(var(--cross-right-h-offset) + var(--cross-size) / 2) var(--cross-bottom-v-offset) / calc(var(--cross-size) / 2) var(--cross-size),
			radial-gradient(
				circle at calc(var(--cross-size) / 2) calc(-1 * var(--cross-big-circle-offset)),
				transparent 0 var(--cross-big-circle-radius),
				var(--red) 0 100%
			) no-repeat var(--cross-right-h-offset) var(--cross-bottom-v-offset) / var(--cross-size) calc(var(--cross-size) / 2),
			radial-gradient(
				circle at calc(var(--cross-size) / 2) calc(var(--cross-size) / 2 + var(--cross-big-circle-offset)),
				transparent 0 var(--cross-big-circle-radius),
				var(--red) 0 100%
			) no-repeat var(--cross-right-h-offset) calc(var(--cross-bottom-v-offset) + var(--cross-size) / 2) / var(--cross-size) calc(var(--cross-size) / 2),

			/* Bottom Left Cross */
			/* small circles */
			radial-gradient(
				circle at calc(var(--cross-size) / 2) calc(-1 * var(--cross-small-circle-offset)),
				var(--white) 0 var(--cross-small-circle-radius),
				transparent 0 100%
			) no-repeat var(--cross-h-offset) var(--cross-bottom-v-offset) / var(--cross-size) var(--cross-size),
			radial-gradient(
				circle at calc(var(--cross-size) / 2) calc(var(--cross-size) + var(--cross-small-circle-offset)),
				var(--white) 0 var(--cross-small-circle-radius),
				transparent 0 100%
			) no-repeat var(--cross-h-offset) var(--cross-bottom-v-offset) / var(--cross-size) var(--cross-size),
			radial-gradient(
				circle at calc(-1 * var(--cross-small-circle-offset)) calc(var(--cross-size) / 2),
				var(--white) 0 var(--cross-small-circle-radius),
				transparent 0 100%
			) no-repeat var(--cross-h-offset) var(--cross-bottom-v-offset) / var(--cross-size) var(--cross-size),
			radial-gradient(
				circle at calc(var(--cross-size) + var(--cross-small-circle-offset)) calc(var(--cross-size) / 2),
				var(--white) 0 var(--cross-small-circle-radius),
				transparent 0 100%
			) no-repeat var(--cross-h-offset) var(--cross-bottom-v-offset) / var(--cross-size) var(--cross-size),
			/* big circles */
			radial-gradient(
				circle at calc(-1 * var(--cross-big-circle-offset)) calc(var(--cross-size) / 2),
				transparent 0 var(--cross-big-circle-radius),
				var(--red) 0 100%
			) no-repeat var(--cross-h-offset) var(--cross-bottom-v-offset) / calc(var(--cross-size) / 2) var(--cross-size),
			radial-gradient(
				circle at calc(var(--cross-size) / 2 + var(--cross-big-circle-offset)) calc(var(--cross-size) / 2),
				transparent 0 var(--cross-big-circle-radius),
				var(--red) 0 100%
			) no-repeat calc(var(--cross-h-offset) + var(--cross-size) / 2) var(--cross-bottom-v-offset) / calc(var(--cross-size) / 2) var(--cross-size),
			radial-gradient(
				circle at calc(var(--cross-size) / 2) calc(-1 * var(--cross-big-circle-offset)),
				transparent 0 var(--cross-big-circle-radius),
				var(--red) 0 100%
			) no-repeat var(--cross-h-offset) var(--cross-bottom-v-offset) / var(--cross-size) calc(var(--cross-size) / 2),
			radial-gradient(
				circle at calc(var(--cross-size) / 2) calc(var(--cross-size) / 2 + var(--cross-big-circle-offset)),
				transparent 0 var(--cross-big-circle-radius),
				var(--red) 0 100%
			) no-repeat var(--cross-h-offset) calc(var(--cross-bottom-v-offset) + var(--cross-size) / 2) / var(--cross-size) calc(var(--cross-size) / 2),

			/* Center Cross */
			linear-gradient(
				180deg,
				transparent 0 calc(var(--scale) * 80),
				var(--red) 0 calc(var(--scale) * 120),
				transparent 0 100%
			),
			linear-gradient(
				90deg,
				transparent 0 calc(var(--scale) * 130),
				var(--red) 0 calc(var(--scale) * 170),
				transparent 0 100%

			)
		;
		background-color: var(--white);
	}
</style>
