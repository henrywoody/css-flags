---
import FlagSection from "../FlagSection.astro";
import DescriptionSection from "../DescriptionSection.astro";
import ExternalLink from "../ExternalLink.astro";
import { type HeadingLevel, toHeadingLevel } from "../../utilities";

export interface Props {
	headingLevel?: HeadingLevel;
}

const { headingLevel = 2 }: Props = Astro.props;
---

<FlagSection title="Latvia" headingLevel={headingLevel}>
	<DescriptionSection title="Description" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			The national flag of Latvia (Latvian: <em>Latvijas karogs</em>) was used by independent Latvia from 1918 until the
			country was occupied by the Soviet Union in 1940. Its use was suppressed during Soviet rule. On 27 February 1990,
			shortly before the country regained its independence, the Latvian government re-adopted the traditional
			red-white-red flag. (Source:{" "}
			<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Latvia">Wikipedia</ExternalLink>)
		</p>
	</DescriptionSection>

	<DescriptionSection title="Construction" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			Created with a <code>linear-gradient</code>.
		</p>
	</DescriptionSection>

	<DescriptionSection title="Sources" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<ul class="citation-list">
			<li>
				Wikipedia:{" "}
				<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Latvia">"Flag of Latvia"</ExternalLink>
			</li>
		</ul>
	</DescriptionSection>
</FlagSection>

<style is:global>
	/* prettier-ignore */
	.flag.flag--latvia {
		--white: #fff;
		--carmine: #9d2235;

		--proportion: calc(1 / 2);

		background-image:
			linear-gradient(
				180deg,
				var(--carmine) 0 calc(2 / 5 * var(--height)),
				var(--white) 0 calc(3 / 5 * var(--height)),
				var(--carmine) 0 calc(5 / 5 * var(--height))
			)
		;
	}
</style>
