---
import FlagSection from "../FlagSection.astro";
import DescriptionSection from "../DescriptionSection.astro";
import ExternalLink from "../ExternalLink.astro";
import { type HeadingLevel, toHeadingLevel } from "../../utilities";

export interface Props {
	headingLevel?: HeadingLevel;
}

const { headingLevel = 2 }: Props = Astro.props;
---

<FlagSection title="Saint Kitts and Nevis" headingLevel={headingLevel}>
	<DescriptionSection title="Description" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			The flag of Saint Kitts and Nevis consists of a yellow-edged black band containing two white stars that divides
			diagonally from the lower hoist-side corner, with a green upper triangle and red lower triangle. Adopted in 1983
			to replace the flag of Saint Christopher-Nevis-Anguilla, it has been the flag of the Federation of Saint Kitts and
			Nevis since the country gained independence that year. Although the flag utilises the colours of the
			Pan-Africanist movement, the symbolism behind them is interpreted differently. The three islands later became part
			of the West Indies Federation in 1958; after this dissolved four years later, they were granted the status of
			associate state as Saint Christopher-Nevis-Anguilla. However, Anguilla decided to secede from the federation in
			1969, owing to fears that their population, which was already small, would be further marginalised in parliament.
			This was eventually formalised in 1980, and a new flag for the remaining parts of the federation was needed, since
			the symbolism of the previous flag centred on the concept of a union of three. (Source: <ExternalLink
				href="https://en.wikipedia.org/wiki/Flag_of_Saint_Kitts_and_Nevis">Wikipedia</ExternalLink
			>)
		</p>
	</DescriptionSection>

	<DescriptionSection title="Construction" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			Created with a <code>linear-gradient</code> for the stripes and six <code>conic-gradient</code>s for each of the
			stars.
		</p>
	</DescriptionSection>

	<DescriptionSection title="Sources" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<ul class="citation-list">
			<li>
				Scheme Color:{" "}
				<ExternalLink href="https://www.schemecolor.com/saint-kitts-and-nevis-flag-colors.php">
					"Saint Kitts and Nevis Flag Colors"
				</ExternalLink>
			</li>
			<li>
				Vexilla Mundi:{" "}
				<ExternalLink href="http://www.vexilla-mundi.com/saint_kitts_flag.html"> "Saint Kitts and Nevis" </ExternalLink>
			</li>
			<li>
				Wikipedia:{" "}
				<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_Saint_Kitts_and_Nevis">
					"Flag of Saint Kitts and Nevis"
				</ExternalLink>
			</li>
		</ul>
	</DescriptionSection>
</FlagSection>

<style is:global>
	/* prettier-ignore */
	.flag.flag--saint-kitts-and-nevis {
		--green: #009e49;
		--yellow: #fcd116;
		--black: #000;
		--white: #fff;
		--red: #ce1126;

		--proportion: calc(2 / 3);

		--diagonal-angle: 33.69deg;

		--star-color: var(--white);
		--star-background-color: var(--black);
		--star-radius: calc(14 / 150 * var(--width));
		--star-inner-radius: calc(
			var(--star-radius) * var(--sin-54) - var(--star-radius) * var(--cos-54) * var(--tan-36)
		);

		--star-top-angle: 146.31deg;
		--star-top-sin: 0.83205;
		--star-top-cos: -0.55470;
		--star-right-angle: calc(var(--star-top-angle) + 144deg);
		--star-right-sin: -0.34710;
		--star-right-cos: 0.93783;
		--star-left-angle: calc(var(--star-top-angle) - 144deg);
		--star-left-sin: -0.99919;
		--star-left-cos: -0.04031;

		--left-star-x: calc(48 / 150 * var(--width) - var(--star-radius));
		--left-star-y: calc(68 / 100 * var(--height) - var(--star-radius));

		--right-star-x: calc(105 / 150 * var(--width) - var(--star-radius));
		--right-star-y: calc(30 / 100 * var(--height) - var(--star-radius));

		background:
			/* Stripes */
			linear-gradient(
				calc(180deg - var(--diagonal-angle)),
				var(--green) 0 calc(50% - 21 / 150 * var(--width)),
				var(--yellow) 0 calc(50% - 15 / 150 * var(--width)),
				transparent 0 calc(50% + 15 / 150 * var(--width)),
				var(--yellow) 0 calc(50% + 21 / 150 * var(--width)),
				var(--red) 0 100%
			),

			/* Left Star */
			/* covers */
			conic-gradient(
				from calc(var(--star-top-angle) - var(--star-indent-angle) / 2)
				at calc(50% + var(--star-inner-radius) * -1 * var(--star-top-cos)) calc(50% - var(--star-inner-radius) * -1 * var(--star-top-sin)),
				var(--star-background-color) 0 var(--star-indent-angle),
				transparent 0 360deg
			) no-repeat calc(var(--left-star-x) - 1px) calc(var(--left-star-y) - 1px) / calc(2 * var(--star-radius) + 2px) calc(2 * var(--star-radius) + 2px),
			conic-gradient(
				from calc(var(--star-right-angle) - var(--star-indent-angle) / 2)
				at calc(50% + var(--star-inner-radius) * -1 * var(--star-right-cos)) calc(50% - var(--star-inner-radius) * -1 * var(--star-right-sin)),
				var(--star-background-color) 0 var(--star-indent-angle),
				transparent 0 360deg
			) no-repeat calc(var(--left-star-x) - 1px) calc(var(--left-star-y) - 1px) / calc(2 * var(--star-radius) + 2px) calc(2 * var(--star-radius) + 2px),
			conic-gradient(
				from calc(var(--star-left-angle) - var(--star-indent-angle) / 2)
				at calc(50% + var(--star-inner-radius) * -1 * var(--star-left-cos)) calc(50% - var(--star-inner-radius) * -1 * var(--star-left-sin)),
				var(--star-background-color) 0 var(--star-indent-angle),
				transparent 0 360deg
			) no-repeat calc(var(--left-star-x) - 1px) calc(var(--left-star-y) - 1px) / calc(2 * var(--star-radius) + 2px) calc(2 * var(--star-radius) + 2px),
			/* star */
			conic-gradient(
				from calc(var(--star-top-angle) - var(--star-interior-angle) / 2)
				at calc(50% + var(--star-radius) * var(--star-top-cos)) calc(50% - var(--star-radius) * var(--star-top-sin)),
				var(--star-color) 0 var(--star-interior-angle),
				transparent 0 360deg
			) no-repeat var(--left-star-x) var(--left-star-y) / calc(2 * var(--star-radius)) calc(2 * var(--star-radius)),
			conic-gradient(
				from calc(var(--star-right-angle) - var(--star-interior-angle) / 2)
				at calc(50% + var(--star-radius) * var(--star-right-cos)) calc(50% - var(--star-radius) * var(--star-right-sin)),
				var(--star-color) 0 var(--star-interior-angle),
				transparent 0 360deg
			) no-repeat var(--left-star-x) var(--left-star-y) / calc(2 * var(--star-radius)) calc(2 * var(--star-radius)),
			conic-gradient(
				from calc(var(--star-left-angle) - var(--star-interior-angle) / 2)
				at calc(50% + var(--star-radius) * var(--star-left-cos)) calc(50% - var(--star-radius) * var(--star-left-sin)),
				var(--star-color) 0 var(--star-interior-angle),
				transparent 0 360deg
			) no-repeat var(--left-star-x) var(--left-star-y) / calc(2 * var(--star-radius)) calc(2 * var(--star-radius)),

			/* Right Star */
			/* covers */
			conic-gradient(
				from calc(var(--star-top-angle) - var(--star-indent-angle) / 2)
				at calc(50% + var(--star-inner-radius) * -1 * var(--star-top-cos)) calc(50% - var(--star-inner-radius) * -1 * var(--star-top-sin)),
				var(--star-background-color) 0 var(--star-indent-angle),
				transparent 0 360deg
			) no-repeat calc(var(--right-star-x) - 1px) calc(var(--right-star-y) - 1px) / calc(2 * var(--star-radius) + 2px) calc(2 * var(--star-radius) + 2px),
			conic-gradient(
				from calc(var(--star-right-angle) - var(--star-indent-angle) / 2)
				at calc(50% + var(--star-inner-radius) * -1 * var(--star-right-cos)) calc(50% - var(--star-inner-radius) * -1 * var(--star-right-sin)),
				var(--star-background-color) 0 var(--star-indent-angle),
				transparent 0 360deg
			) no-repeat calc(var(--right-star-x) - 1px) calc(var(--right-star-y) - 1px) / calc(2 * var(--star-radius) + 2px) calc(2 * var(--star-radius) + 2px),
			conic-gradient(
				from calc(var(--star-left-angle) - var(--star-indent-angle) / 2)
				at calc(50% + var(--star-inner-radius) * -1 * var(--star-left-cos)) calc(50% - var(--star-inner-radius) * -1 * var(--star-left-sin)),
				var(--star-background-color) 0 var(--star-indent-angle),
				transparent 0 360deg
			) no-repeat calc(var(--right-star-x) - 1px) calc(var(--right-star-y) - 1px) / calc(2 * var(--star-radius) + 2px) calc(2 * var(--star-radius) + 2px),
			/* star */
			conic-gradient(
				from calc(var(--star-top-angle) - var(--star-interior-angle) / 2)
				at calc(50% + var(--star-radius) * var(--star-top-cos)) calc(50% - var(--star-radius) * var(--star-top-sin)),
				var(--star-color) 0 var(--star-interior-angle),
				transparent 0 360deg
			) no-repeat var(--right-star-x) var(--right-star-y) / calc(2 * var(--star-radius)) calc(2 * var(--star-radius)),
			conic-gradient(
				from calc(var(--star-right-angle) - var(--star-interior-angle) / 2)
				at calc(50% + var(--star-radius) * var(--star-right-cos)) calc(50% - var(--star-radius) * var(--star-right-sin)),
				var(--star-color) 0 var(--star-interior-angle),
				transparent 0 360deg
			) no-repeat var(--right-star-x) var(--right-star-y) / calc(2 * var(--star-radius)) calc(2 * var(--star-radius)),
			conic-gradient(
				from calc(var(--star-left-angle) - var(--star-interior-angle) / 2)
				at calc(50% + var(--star-radius) * var(--star-left-cos)) calc(50% - var(--star-radius) * var(--star-left-sin)),
				var(--star-color) 0 var(--star-interior-angle),
				transparent 0 360deg
			) no-repeat var(--right-star-x) var(--right-star-y) / calc(2 * var(--star-radius)) calc(2 * var(--star-radius))
		;
		background-color: var(--black);
	}
</style>
