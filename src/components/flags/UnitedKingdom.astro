---
import FlagSection from "../FlagSection.astro";
import DescriptionSection from "../DescriptionSection.astro";
import ExternalLink from "../ExternalLink.astro";
import { type HeadingLevel, toHeadingLevel } from "../../utilities";

export interface Props {
	headingLevel?: HeadingLevel;
}

const { headingLevel = 2 }: Props = Astro.props;
---

<FlagSection title="United Kingdom" flagName="Union Jack" headingLevel={headingLevel}>
	<DescriptionSection title="Description" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>The national flag of the United Kingdom is the Union Jack, also known as the Union Flag.</p>

		<p>
			The current design of the Union Jack dates from the Act of Union 1801 which united the Kingdom of Great Britain
			and the Kingdom of Ireland (previously in personal union) to create the United Kingdom of Great Britain and
			Ireland. The flag consists of the red cross of Saint George (patron saint of England), edged in white,
			superimposed on the Cross of St Patrick (patron saint of Ireland), which are superimposed on the Saltire of Saint
			Andrew (patron saint of Scotland). Wales is not represented in the Union Flag by Wales's patron saint, Saint
			David, as at the time the flag was designed Wales was part of the Kingdom of England. (Source:{" "}
			<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_the_United_Kingdom">Wikipedia</ExternalLink>)
		</p>
	</DescriptionSection>

	<DescriptionSection title="Construction" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<p>
			Created with a series of <code>linear-gradient</code>s.
		</p>
	</DescriptionSection>

	<DescriptionSection title="Sources" headingLevel={toHeadingLevel(headingLevel + 1)}>
		<ul class="citation-list">
			<li>
				Vexilla Mundi:{" "}
				<ExternalLink href="http://www.vexilla-mundi.com/united_kingdom_flag.html">
					"United Kingdom of Great Britain and Northern Ireland"
				</ExternalLink>
			</li>
			<li>
				Wikipedia:{" "}
				<ExternalLink href="https://en.wikipedia.org/wiki/Flag_of_the_United_Kingdom">
					"Flag of the United Kingdom"
				</ExternalLink>
			</li>
		</ul>
	</DescriptionSection>
</FlagSection>

<style is:global>
	/* prettier-ignore */
	.flag.flag--united-kingdom {
		--white: #fff;
		--blue: #012169;
		--red: #c8102e;

		--proportion: calc(1 / 2);
		--diagonal-angle: 26.5650512deg; /* arctan(--proportion) */

		background-image:
			linear-gradient(
				0deg,
				transparent calc(12 / 30 * 100%),
				var(--red) calc(12 / 30 * 100%),
				var(--red) calc(18 / 30 * 100%),
				transparent calc(18 / 30 * 100%)
			),
			linear-gradient(
				90deg,
				transparent calc(27 / 60 * 100%),
				var(--red) calc(27 / 60 * 100%),
				var(--red) calc(33 / 60 * 100%),
				transparent calc(33 / 60 * 100%)
			),
			linear-gradient(
				0deg,
				transparent calc(10 / 30 * 100%),
				var(--white) calc(10 / 30 * 100%),
				var(--white) calc(20 / 30 * 100%),
				transparent calc(20 / 30 * 100%)
			),
			linear-gradient(
				90deg,
				transparent calc(25 / 60 * 100%),
				var(--white) calc(25 / 60 * 100%),
				var(--white) calc(35 / 60 * 100%),
				transparent calc(35 / 60 * 100%)
			);
		position: relative;
	}

	.flag.flag--united-kingdom::before,
	.flag.flag--united-kingdom::after {
		content: "";
		background-color: var(--blue);
		width: 100%;
		height: 50%;
		position: absolute;
		left: 0;
		z-index: -1;
	}

	.flag.flag--united-kingdom::before {
		top: 0;
		background-image:
			linear-gradient(
				var(--diagonal-angle),
				transparent calc((11 + 0.4) / 30 * var(--height)),
				var(--red) calc((11 + 0.4) / 30 * var(--height)),
				var(--red) calc((13 + 0.4) / 30 * var(--height)),
				transparent calc((13 + 0.4) / 30 * var(--height))
			),
			linear-gradient(
				calc(-1 * var(--diagonal-angle)),
				transparent calc((13 + 0.4) / 30 * var(--height)),
				var(--red) calc((13 + 0.4) / 30 * var(--height)),
				var(--red) calc((15 + 0.4) / 30 * var(--height)),
				transparent calc((15 + 0.4) / 30 * var(--height))
			),
			linear-gradient(
				var(--diagonal-angle),
				transparent calc((10 + 0.4) / 30 * var(--height)),
				var(--white) calc((10 + 0.4) / 30 * var(--height)),
				var(--white) calc((16 + 0.4) / 30 * var(--height)),
				transparent calc((16 + 0.4) / 30 * var(--height))
			),
			linear-gradient(
				calc(-1 * var(--diagonal-angle)),
				transparent calc((10 + 0.4) / 30 * var(--height)),
				var(--white) calc((10 + 0.4) / 30 * var(--height)),
				var(--white) calc((16 + 0.4) / 30 * var(--height)),
				transparent calc((16 + 0.4) / 30 * var(--height))
			);
	}

	.flag.flag--united-kingdom::after {
		bottom: 0;
		background-image:
			linear-gradient(
				var(--diagonal-angle),
				transparent calc((15 + 11.8) / 30 * var(--height)),
				var(--red) calc((15 + 11.8) / 30 * var(--height)),
				var(--red) calc((17 + 11.8) / 30 * var(--height)),
				transparent calc((17 + 11.8) / 30 * var(--height))
			),
			linear-gradient(
				calc(-1 * var(--diagonal-angle)),
				transparent calc((15 + 9.8) / 30 * var(--height)),
				var(--red) calc((15 + 9.8) / 30 * var(--height)),
				var(--red) calc((17 + 9.8) / 30 * var(--height)),
				transparent calc((17 + 9.8) / 30 * var(--height))
			),
			linear-gradient(
				var(--diagonal-angle),
				transparent calc((12 + 11.8) / 30 * var(--height)),
				var(--white) calc((12 + 11.8) / 30 * var(--height)),
				var(--white) calc((18 + 11.8) / 30 * var(--height)),
				transparent calc((18 + 11.8) / 30 * var(--height))
			),
			linear-gradient(
				calc(-1 * var(--diagonal-angle)),
				transparent calc((12 + 11.8) / 30 * var(--height)),
				var(--white) calc((12 + 11.8) / 30 * var(--height)),
				var(--white) calc((18 + 11.8) / 30 * var(--height)),
				transparent calc((18 + 11.8) / 30 * var(--height))
			);
	}
</style>
